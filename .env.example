# Azure DevOps organization name, e.g. "https://dev.azure.com/myorg" -> myorg
ADO_ORG=

# Default project name (can be overridden per-call in code)
ADO_PROJECT=

# Personal Access Token. Create one at
# https://dev.azure.com/{org}/_usersSettings/tokens
# Scope it to only the areas you need (Work Items: Read, Code: Read,
# Build: Read, Project and Team: Read are usually enough for read-only use).
ADO_PAT=
